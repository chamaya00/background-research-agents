{
  "name": "research-brief",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic core of the research-brief pipeline: reads state and source files, selects and ranks candidate items, and writes each one with knowledge-aware deltas.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "verify-network": "npm run build && node scripts/verify-network.mjs"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "fast-xml-parser": "^5.11.1",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.11.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
